# --- data and build output (never committed; see README) ---
data/raw/
data/cache/
data/previous/
data/verify/
data/discovery_state.json
dist/
# site/data: only mesh_data.js and geo/ are committed (Pages serves them). The
# mesh tool also writes the .bin / .json / .parquet there; the page reads none.
site/data/*
!site/data/mesh_data.js
!site/data/geo/
reports/*.csv
!reports/.gitkeep

# --- local-only working files, not part of the published repository ---
.local/
docs/assets/logo-original.png

# --- identity ledger: the ledger itself IS committed, its scratch files are not ---
identity/*.csv.gz.tmp
identity/*.staged

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# --- editors, OS and local tooling ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
.claude/
node_modules/
.env
.env.*

# --- logs and profiling output ---
*.log
*.cpuprofile

# --- stray temporaries ---
*.tmp
*.bak
